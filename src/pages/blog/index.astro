---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import Img from '@/components/Img.astro';
const posts = (await getCollection('posts', p => !p.data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const cats: Record<string, string> = { education: 'Education', news: 'News', 'contrast-therapy': 'Contrast therapy', 'red-light': 'Red light', 'science-research': 'Science & research' };
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="Blog — Recovery, HBOT and Longevity Education" description="Plain-English guides to hyperbaric oxygen therapy, contrast therapy and red light, from the OneBase medical and engineering team.">
  <section class="pt-36 pb-12">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">Education</p>
      <h1 class="mt-3">Learn the science. Skip the jargon.</h1>
      <p class="mt-5 text-ob-grey-700">Research-backed, written so anyone can act on it.</p>
    </div>
  </section>
  <section class="container-wide pb-24">
    {posts.length === 0 ? (
      <div class="rounded-ob ring-1 ring-ob-grey p-8 text-sm text-ob-grey-700">
        No posts yet. Run <code>npm run import:blog</code> to migrate the 41 articles from Shopify into <code>src/content/posts/</code>.
      </div>
    ) : (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map(p => (
          <a href={`/blog/${p.id}`} class="group">
            <div class="aspect-[16/10] overflow-hidden rounded-ob bg-ob-grey-50"><Img src={p.data.heroImage} alt={p.data.title} class="h-full w-full object-cover transition group-hover:scale-[1.03]" /></div>
            <p class="eyebrow mt-4">{cats[p.data.category]} · {fmt(p.data.pubDate)}</p>
            <h2 class="mt-2 text-xl group-hover:underline underline-offset-4">{p.data.title}</h2>
            {p.data.description && <p class="mt-2 text-sm text-ob-grey-700 line-clamp-2">{p.data.description}</p>}
          </a>
        ))}
      </div>
    )}
  </section>
</Base>
