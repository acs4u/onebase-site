---
import Base from '@/layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import Img from '@/components/Img.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/lib/site';
export async function getStaticPaths() {
  return (await getCollection('posts', p => !p.data.draft)).map(p => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, datePublished: d.pubDate.toISOString(), dateModified: (d.updatedDate ?? d.pubDate).toISOString(), author: { '@type': 'Organization', name: d.author }, publisher: { '@type': 'Organization', name: site.name }, image: d.heroImage ? site.url + d.heroImage : undefined };
---
<Base title={d.title} description={d.description} image={d.heroImage} jsonLd={jsonLd}>
  <article class="pt-36 pb-20">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">{d.category.replace('-', ' ')} · {fmt(d.pubDate)}</p>
      <h1 class="mt-3 text-4xl md:text-5xl">{d.title}</h1>
      {d.description && <p class="key-message mt-4 text-ob-grey-700 text-xl md:text-2xl">{d.description}</p>}
      {d.heroImage && <div class="mt-8 aspect-[16/9] overflow-hidden rounded-ob bg-ob-grey-50"><Img src={d.heroImage} alt={d.title} class="h-full w-full object-cover" loading="eager" /></div>}
      <div class="prose-ob mt-10 text-ob-grey-700"><Content /></div>
      <p class="mt-12 text-xs text-ob-grey-500">For information and educational purposes only; not medical advice. Ask your doctor whether any therapy is appropriate for you.</p>
    </div>
  </article>
  <CtaBand heading="Want this in your facility?" body="Talk to our team about the equipment behind the research." />
</Base>
