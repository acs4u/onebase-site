---
import Base from '@/layouts/Base.astro';
import EnquiryForm from '@/components/EnquiryForm.astro';
import { site } from '@/lib/site';
---
<Base title="Contact OneBase Health" description="Talk to the OneBase sales team about HBOT chambers, cold therapy rooms, infrared saunas and red light for your facility.">
  <section class="pt-36 pb-4">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-3">Let's plan your recovery space.</h1>
      <div class="mt-8 grid gap-6 sm:grid-cols-3 text-sm">
        <div><p class="eyebrow">North America</p><p class="mt-2"><a href={site.phoneUSHref} class="font-display font-medium">{site.phoneUS}</a><br/><a href={site.bookingUrl} rel="noopener" class="underline underline-offset-4">Schedule a call</a></p></div>
        <div><p class="eyebrow">Australia & APAC</p><p class="mt-2">Perth, Western Australia<br/><a href={`mailto:${site.salesEmail}`} class="underline underline-offset-4">{site.salesEmail}</a></p></div>
        <div><p class="eyebrow">Customer service</p><p class="mt-2"><a href={`mailto:${site.serviceEmail}`} class="underline underline-offset-4">{site.serviceEmail}</a><br/>Warranty, parts and support</p></div>
      </div>
    </div>
  </section>
  <EnquiryForm />
</Base>
