---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import Img from '@/components/Img.astro';
import CtaBand from '@/components/CtaBand.astro';
const solutions = (await getCollection('solutions')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Industry Solutions" description="OneBase equips facilities across fitness, sports, hospitality, real estate, corporate wellness and defence with commercial-grade recovery equipment and software.">
  <section class="pt-36 pb-12">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">Solutions</p>
      <h1 class="mt-3">Recovery, built for the way your facility runs.</h1>
      <p class="mt-5 text-ob-grey-700">Every industry has its own throughput, footprint and procurement needs. Pick yours and we'll show you the configurations that work, and the operators already running them.</p>
    </div>
  </section>
  <section class="container-wide pb-20 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {solutions.map(s => (
      <a href={`/solutions/${s.id}`} class="group relative aspect-[4/3] overflow-hidden rounded-ob bg-ob-black text-white">
        <Img src={s.data.heroImage} alt={s.data.label} class="absolute inset-0 h-full w-full object-cover opacity-80 transition group-hover:scale-[1.03]" />
        <div class="absolute inset-0 hero-overlay"></div>
        <div class="absolute inset-x-0 bottom-0 p-6">
          <h2 class="text-xl md:text-2xl text-white">{s.data.label}</h2>
          <p class="mt-1 text-sm text-white/75 line-clamp-2">{s.data.heroHeading}</p>
        </div>
      </a>
    ))}
  </section>
  <CtaBand />
</Base>
