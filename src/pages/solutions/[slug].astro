---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site, modalities } from '@/lib/site';
import Img from '@/components/Img.astro';
import ProductCard from '@/components/ProductCard.astro';
import EnquiryForm from '@/components/EnquiryForm.astro';
import PrecorBadge from '@/components/PrecorBadge.astro';

export async function getStaticPaths() {
  return (await getCollection('solutions')).map(s => ({ params: { slug: s.id }, props: { solution: s } }));
}
const { solution } = Astro.props;
const s = solution.data;
const products = (await getCollection('products', p => s.modalities.includes(p.data.modality))).sort((a, b) => a.data.order - b.data.order);
const featured = ['icevault', 'yakisugi', 'lightbed', 'airform'].map(id => products.find(p => p.id === id)!).filter(Boolean);
const jsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
  { '@type': 'ListItem', position: 2, name: 'Solutions', item: `${site.url}/solutions` },
  { '@type': 'ListItem', position: 3, name: s.label, item: `${site.url}/solutions/${solution.id}` } ] };
---
<Base title={s.seoTitle} description={s.seoDescription} dark jsonLd={jsonLd}>
  <section class="relative isolate min-h-[70vh] flex items-end bg-ob-ink text-white">
    <div class="absolute inset-0 -z-10">
      <Img src={s.heroImage} alt={s.label} class="h-full w-full object-cover" loading="eager" hideLabel />
      <div class="absolute inset-0 hero-overlay"></div>
    </div>
    <div class="container-wide pb-16 pt-40">
      <p class="eyebrow text-white/70">{s.label}</p>
      <h1 class="mt-3 max-w-3xl text-white">{s.heroHeading}</h1>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#contact-form" class="btn-on-dark">Contact sales</a>
        {s.precorChannel && <PrecorBadge />}
      </div>
    </div>
  </section>

  <section class="bg-ob-black text-white">
    <div class="container-wide py-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {s.valueProps.map(v => (
        <div class="border-t border-white/15 pt-5">
          <h3 class="text-white">{v.title}</h3>
          <p class="mt-3 text-sm text-white/70">{v.body}</p>
        </div>
      ))}
    </div>
  </section>

  {s.features.map((f, i) => (
    <section class="section">
      <div class:list={['container-wide grid gap-12 lg:grid-cols-2 lg:items-center']}>
        <div class:list={['rounded-ob overflow-hidden bg-ob-grey-50 aspect-[4/3]', i % 2 === 1 && 'lg:order-2']}>
          <Img src={f.image} alt={f.title} class="h-full w-full object-cover" />
        </div>
        <div>
          <h2 class="text-3xl md:text-4xl">{f.title}</h2>
          <p class="mt-5 text-ob-grey-700">{f.body}</p>
        </div>
      </div>
    </section>
  ))}

  <section class="section bg-ob-grey-50">
    <div class="container-wide">
      <p class="eyebrow">Recommended for {s.label.toLowerCase()}</p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">{featured.map(p => <ProductCard product={p} />)}</div>
      <p class="mt-6 text-sm text-ob-grey-500">Modalities: {s.modalities.map(m => modalities[m].name).join(' · ')}</p>
    </div>
  </section>

  <EnquiryForm heading={`Let's plan your ${s.label.toLowerCase()} install`} compact />
</Base>
