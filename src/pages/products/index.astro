---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { modalities } from '@/lib/site';
import ProductCard from '@/components/ProductCard.astro';
import CtaBand from '@/components/CtaBand.astro';
const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Commercial Recovery Equipment" description="Commercial-grade HBOT chambers, dry cold therapy rooms, infrared saunas and red light devices. Engineered for durability, throughput and return on investment.">
  <section class="pt-36 pb-12">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">Products</p>
      <h1 class="mt-3">Commercial-grade, by design.</h1>
      <p class="mt-5 text-ob-grey-700">Every product is engineered for daily commercial use: durable builds, plug-and-play installs, self-cleaning where it matters, and connection to the OneBase platform.</p>
    </div>
  </section>
  {Object.values(modalities).map(m => (
    <section class="container-wide py-12 border-t border-ob-grey" id={m.category} data-modality={m.key}>
      <div class="flex items-end justify-between gap-6">
        <div>
          <p class="eyebrow accent-text">{m.label}</p>
          <h2 class="mt-2 text-2xl md:text-3xl">{m.name}</h2>
        </div>
        <a href={m.path} class="font-display text-sm font-medium underline underline-offset-4">Overview</a>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {products.filter(p => p.data.category === m.category).map(p => <ProductCard product={p} />)}
      </div>
    </section>
  ))}
  <CtaBand />
</Base>
