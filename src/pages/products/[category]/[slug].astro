---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site, modalities, categoryToModality, productName } from '@/lib/site';
import Img from '@/components/Img.astro';
import SpecTable from '@/components/SpecTable.astro';
import PrecorBadge from '@/components/PrecorBadge.astro';
import EnquiryForm from '@/components/EnquiryForm.astro';
import ProductCard from '@/components/ProductCard.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map(p => ({ params: { category: p.data.category, slug: p.id }, props: { product: p } }));
}
const { product } = Astro.props;
const p = product.data;
const mod = modalities[categoryToModality[p.category]];
const name = productName(p.name);
const related = (await getCollection('products', x => x.data.category === p.category && x.id !== product.id)).sort((a, b) => a.data.order - b.data.order);
const url = `${site.url}/products/${p.category}/${product.id}`;

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Product', name, description: p.tagline, brand: { '@type': 'Brand', name: 'OneBase' }, image: p.images.map(i => site.url + i.src), url,
    ...(p.fromPriceUSD ? { offers: { '@type': 'AggregateOffer', priceCurrency: 'USD', lowPrice: p.fromPriceUSD, availability: 'https://schema.org/InStock', url } } : {}) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `${site.url}/products` },
    { '@type': 'ListItem', position: 3, name: mod.name, item: site.url + mod.path },
    { '@type': 'ListItem', position: 4, name, item: url } ] },
  ...(p.faqs.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Base title={p.seoTitle ?? name} description={p.seoDescription ?? p.tagline} image={p.images[0]?.src} jsonLd={jsonLd}>
  <div data-modality={p.modality}>
    <!-- Hero -->
    <section class="pt-32 pb-12 md:pt-40">
      <div class="container-wide">
        <nav class="text-xs text-ob-grey-500 font-display" aria-label="Breadcrumb">
          <a href="/products" class="hover:text-ob-black">Products</a> / <a href={mod.path} class="hover:text-ob-black">{mod.name}</a> / <span class="text-ob-black">{name}</span>
        </nav>
        <div class="mt-8 grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-start">
          <div class="rounded-ob accent-soft-bg aspect-[4/3] overflow-hidden">
            <Img src={p.images[0]?.src} alt={p.images[0]?.alt ?? name} class="h-full w-full object-contain p-8" loading="eager" />
          </div>
          <div>
            <p class="eyebrow accent-text">{mod.label} · {mod.name}</p>
            <h1 class="mt-3 text-4xl md:text-5xl">{name}</h1>
            <p class="key-message mt-4 text-ob-grey-700 text-xl md:text-2xl">{p.tagline}</p>
            <p class="mt-6 text-ob-grey-700">{p.description}</p>

            <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
              {p.sizes.length > 0 && <div><dt class="eyebrow">Sizes</dt><dd class="mt-1 font-display">{p.sizes.map(s => s.label).join(' · ')}</dd></div>}
              {p.colours.length > 0 && <div><dt class="eyebrow">Finishes</dt><dd class="mt-1 font-display">{p.colours.join(' · ')}</dd></div>}
              {p.pressures.length > 0 && <div><dt class="eyebrow">Pressure</dt><dd class="mt-1 font-display">{p.pressures.join(' · ')}</dd></div>}
              {p.certifications.length > 0 && <div><dt class="eyebrow">Certifications</dt><dd class="mt-1 font-display">{p.certifications.join(' · ')}</dd></div>}
            </dl>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href="#contact-form" class="btn-primary">Talk to our team</a>
              <a href={site.bookingUrl} rel="noopener" class="btn-ghost">Schedule a call</a>
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-ob-grey-500">
              {p.status === 'coming-soon' ? <span>Taking pre-orders</span> : <span>Installation service · US-based support · 2-year warranty</span>}
              {p.channels.precor && <PrecorBadge />}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sizes -->
    {p.sizes.length > 1 && (
      <section class="container-wide py-10 border-t border-ob-grey">
        <p class="eyebrow">Configurations</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {p.sizes.map(s => (
            <div class="rounded-ob ring-1 ring-ob-grey p-5">
              <h3 class="text-lg">{name} {s.label}</h3>
              {s.note && <p class="mt-2 text-sm text-ob-grey-700">{s.note}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Highlights -->
    <section class="section bg-ob-grey-50">
      <div class="container-wide">
        <p class="eyebrow">Product highlights</p>
        <div class="mt-6 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {p.highlights.map(h => (
            <div class="border-t border-ob-grey-300 pt-4">
              <h3 class="text-lg">{h.title}</h3>
              <p class="mt-2 text-sm text-ob-grey-700">{h.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Specs — a feature, not an accordion -->
    <section class="section">
      <div class="container-wide grid gap-12 lg:grid-cols-2">
        <SpecTable title="Specifications" rows={p.specs} />
        <div class="space-y-10">
          <SpecTable title="Electrical requirements" rows={p.electrical} />
          {p.certifications.length > 0 && (
            <div>
              <h3 class="mb-4">Certifications</h3>
              <div class="flex flex-wrap gap-2">{p.certifications.map(c => <span class="rounded-full border border-ob-grey px-3 py-1 font-display text-xs">{c}</span>)}</div>
            </div>
          )}
          <div class="rounded-ob accent-soft-bg p-6 text-sm">
            <p class="font-display font-medium">Need a spec sheet or CAD?</p>
            <p class="mt-1 text-ob-grey-700">Our engineering team can supply drawings, electrical single-lines and floor-plan guidance for your fit-out.</p>
            <a href="#contact-form" class="mt-3 inline-block font-display font-medium underline underline-offset-4">Request documents</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQs -->
    {p.faqs.length > 0 && (
      <section class="section bg-ob-grey-50">
        <div class="container-wide max-w-4xl">
          <p class="eyebrow">Questions</p>
          <div class="mt-6 divide-y divide-ob-grey-300">
            {p.faqs.map(f => (
              <details class="group py-4">
                <summary class="flex cursor-pointer items-center justify-between font-display font-medium">{f.q}<span class="ml-4 text-ob-grey-500 group-open:rotate-45 transition">+</span></summary>
                <p class="mt-3 text-sm text-ob-grey-700 max-w-3xl">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <EnquiryForm heading={`Ready to add the ${name}?`} product={`${p.category === 'hbot' ? 'HBOT ' : ''}${p.name}`} />

    {related.length > 0 && (
      <section class="section">
        <div class="container-wide">
          <p class="eyebrow">More in {mod.name}</p>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">{related.map(r => <ProductCard product={r} />)}</div>
        </div>
      </section>
    )}
  </div>
</Base>
