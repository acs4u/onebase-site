---
import Base from '@/layouts/Base.astro';
const html = "## Standard warranty coverage\nWe are committed to providing our customers with high-quality products and exceptional support. We offer a **2-year standard warranty** on our products, covering defects in materials and workmanship under normal use and maintenance.\n\n## Warranty specifications\nThe specific warranty period for each purchase is confirmed by the sales representative at the time of sale and stated on the invoice.\n\n## Exclusions and limitations\nThis warranty does not cover: normal wear and tear from regular use (defects in materials and workmanship that lead to premature failure under normal use are covered); improper use, misuse or mishandling; exposure to extreme or unsuitable environmental conditions such as excessive heat, humidity or corrosive elements; unauthorised modifications or repairs; parts or components deemed outside coverage due to misuse or environmental factors.\n\n## Company discretion on warranty claims\nWhere increased wear and tear is suspected due to customer misuse or unsuitable environmental factors, the company reserves the right to determine warranty coverage on a case-by-case basis.\n\n## How to file a warranty claim\nContact our customer service team with proof of purchase and a detailed description of the issue. Our team will evaluate the claim and determine whether it qualifies. Approved claims are resolved promptly through repair or replacement at the company's discretion.\n\n## Commitment to customer support\nWe stand behind our products and are dedicated to exceptional customer service. Contact: customerservice@onebasehealth.com";
---
<Base title="Warranty Policy" description="Warranty Policy for OneBase Health (Waylen Allen Limited).">
  <section class="pt-36 pb-24">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">Policies</p>
      <h1 class="mt-3">Warranty Policy</h1>
      <div class="prose-ob mt-10 text-ob-grey-700" set:html={html.split(/\n\n/).map(b=>b.startsWith("## ")?"<h2>"+b.slice(3)+"</h2>":b.startsWith("_")?"<p><em>"+b.replace(/_/g,"")+"</em></p>":"<p>"+b.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")+"</p>").join("")} />
    </div>
  </section>
</Base>
