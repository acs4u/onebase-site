---
import Base from '@/layouts/Base.astro';
const html = "By accessing onebasehealth.com you agree to these terms. Content on this site is provided for information and educational purposes only and does not constitute medical advice. Product specifications, availability and pricing may change without notice; quotations issued by OneBase govern any purchase. All trademarks, product names and content are the property of Waylen Allen Limited or their respective owners. These terms are governed by the laws of Hong Kong SAR.";
---
<Base title="Terms of Use" description="Terms of Use for OneBase Health (Waylen Allen Limited).">
  <section class="pt-36 pb-24">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">Policies</p>
      <h1 class="mt-3">Terms of Use</h1>
      <div class="prose-ob mt-10 text-ob-grey-700" set:html={html.split(/\n\n/).map(b=>b.startsWith("## ")?"<h2>"+b.slice(3)+"</h2>":b.startsWith("_")?"<p><em>"+b.replace(/_/g,"")+"</em></p>":"<p>"+b.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")+"</p>").join("")} />
    </div>
  </section>
</Base>
