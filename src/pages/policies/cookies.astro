---
import Base from '@/layouts/Base.astro';
const html = "We use cookies and similar technologies to run the site, measure how it is used and improve our marketing. Essential cookies are required for the site to function. Analytics and marketing cookies (Google Tag Manager, Google Analytics, Google Ads, HubSpot, Hotjar and LinkedIn Insight) are set only with your consent where required by law. You can change your preferences at any time via the cookie banner or your browser settings.";
---
<Base title="Cookie Policy" description="Cookie Policy for OneBase Health (Waylen Allen Limited).">
  <section class="pt-36 pb-24">
    <div class="container-wide max-w-3xl">
      <p class="eyebrow">Policies</p>
      <h1 class="mt-3">Cookie Policy</h1>
      <div class="prose-ob mt-10 text-ob-grey-700" set:html={html.split(/\n\n/).map(b=>b.startsWith("## ")?"<h2>"+b.slice(3)+"</h2>":b.startsWith("_")?"<p><em>"+b.replace(/_/g,"")+"</em></p>":"<p>"+b.replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>")+"</p>").join("")} />
    </div>
  </section>
</Base>
