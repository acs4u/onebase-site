---
/*
  Enquiry form. Two modes:
  1. HubSpot embed (preferred — keeps the existing CRM flow and the GTM `hubspot_form_success` event).
     Set site.hubspot.formId to the form GUID from HubSpot → Marketing → Forms → Share → Embed code.
  2. Native fallback (rendered when no formId is set) — posts to /api/enquiry which you can wire to
     HubSpot's Forms API, Resend, or a Vercel function.
*/
import { site } from '@/lib/site';
interface Props { heading?: string; intro?: string; product?: string; compact?: boolean; }
const { heading = 'Tell us about your facility', intro = 'Our team will walk you through product specs, facility planning and pricing tailored to your business. Fill out the form or give us a call.', product, compact = false } = Astro.props;
const products = ['HBOT AirFit', 'HBOT AirFlex', 'HBOT AirForm', 'HBOT AirSuite', 'LightPanel', 'LightBed', 'Yakisugi sauna', 'Hemlock sauna', 'IceVault'];
const industries = ['Fitness facilities', 'Spa / wellness centers', 'Recovery studios', 'Pro sports teams & performance centers', 'Luxury & boutique hospitality', 'High-end real estate developments', 'Multi-family housing', 'Corporate wellness', 'Military & first responders', 'Golf / country clubs', 'Commercial dealers', 'Medical / clinical', 'Other'];
const timelines = ['Ready now (0–30 days)', '1–3 months', '3–6 months', '6+ months', 'Just researching'];
const hs = site.hubspot;
---
<section id="contact-form" class="section bg-ob-grey-50">
  <div class="container-wide grid gap-12 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <p class="eyebrow">Get in touch</p>
      <h2 class="mt-3">{heading}</h2>
      <p class="mt-5 text-ob-grey-700 max-w-md">{intro}</p>
      <div class="mt-8 space-y-3 text-sm">
        <p>Sales: <a href={site.phoneUSHref} class="font-display font-medium">{site.phoneUS}</a></p>
        <p><a href={site.bookingUrl} rel="noopener" class="btn-ghost">Schedule a call</a></p>
      </div>
      <ul class="mt-10 space-y-2 text-sm text-ob-grey-700">
        <li>✓ Facility planning and electrical guidance</li>
        <li>✓ Installation service and staff training</li>
        <li>✓ US and North America-based support</li>
      </ul>
    </div>

    <div class="rounded-ob bg-white p-6 md:p-8 shadow-sm ring-1 ring-ob-grey">
      {hs.formId ? (
        <div id="hubspot-form" data-portal={hs.portalId} data-region={hs.region} data-form={hs.formId}></div>
        <script is:inline src="//js.hsforms.net/forms/embed/v2.js" charset="utf-8" type="text/javascript"></script>
        <script is:inline>
          const el = document.getElementById('hubspot-form');
          window.hbspt && hbspt.forms.create({ portalId: el.dataset.portal, region: el.dataset.region, formId: el.dataset.form, target: '#hubspot-form' });
        </script>
      ) : (
        <form method="post" action="/api/enquiry" class="grid gap-4 sm:grid-cols-2" data-enquiry>
          <label class="text-sm"><span class="block mb-1">First name *</span><input required name="firstname" class="w-full rounded-ob border border-ob-grey px-3 py-2" /></label>
          <label class="text-sm"><span class="block mb-1">Last name *</span><input required name="lastname" class="w-full rounded-ob border border-ob-grey px-3 py-2" /></label>
          <label class="text-sm"><span class="block mb-1">Email *</span><input required type="email" name="email" class="w-full rounded-ob border border-ob-grey px-3 py-2" /></label>
          <label class="text-sm"><span class="block mb-1">Phone</span><input type="tel" name="phone" class="w-full rounded-ob border border-ob-grey px-3 py-2" /></label>
          <label class="text-sm"><span class="block mb-1">Company</span><input name="company" class="w-full rounded-ob border border-ob-grey px-3 py-2" /></label>
          <label class="text-sm"><span class="block mb-1">Country / state</span><input name="region" class="w-full rounded-ob border border-ob-grey px-3 py-2" /></label>
          <label class="text-sm"><span class="block mb-1">Industry</span>
            <select name="industry" class="w-full rounded-ob border border-ob-grey px-3 py-2 bg-white"><option value="">Select</option>{industries.map(i => <option>{i}</option>)}</select></label>
          <label class="text-sm"><span class="block mb-1">Install timeline</span>
            <select name="timeline" class="w-full rounded-ob border border-ob-grey px-3 py-2 bg-white"><option value="">Select</option>{timelines.map(t => <option>{t}</option>)}</select></label>
          {!compact && (
            <fieldset class="sm:col-span-2 text-sm"><legend class="mb-2">Products you're considering *</legend>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                {products.map(p => <label class="flex items-center gap-2"><input type="checkbox" name="products" value={p} checked={product === p} /> {p}</label>)}
              </div>
            </fieldset>
          )}
          <label class="sm:col-span-2 text-sm"><span class="block mb-1">Message</span><textarea name="message" rows="4" class="w-full rounded-ob border border-ob-grey px-3 py-2"></textarea></label>
          <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />
          <div class="sm:col-span-2 flex flex-wrap items-center gap-4">
            <button type="submit" class="btn-primary">Get started</button>
            <p class="text-xs text-ob-grey-500">By submitting, you agree to receive communications from OneBase. Unsubscribe anytime.</p>
          </div>
        </form>
      )}
    </div>
  </div>
</section>
