---
// Renders an image, or a labelled placeholder until assets are imported (npm run import:images).
import fs from 'node:fs';
interface Props { src?: string; alt: string; class?: string; loading?: 'lazy' | 'eager'; hideLabel?: boolean; }
const { src, alt, class: className = '', loading = 'lazy', hideLabel = false } = Astro.props;
const exists = src ? fs.existsSync(`public${src}`) : false;
---
{exists ? (
  <img src={src} alt={alt} class={className} loading={loading} decoding="async" />
) : (
  <div class:list={['flex items-center justify-center bg-ob-grey-50 text-center text-[11px] font-display uppercase tracking-widest text-ob-grey-500', className]} role="img" aria-label={alt}>
    {!hideLabel && <span class="px-4">{alt}</span>}
  </div>
)}
