{
"framework": null,
"installCommand": "echo skip",
"buildCommand": "mkdir -p proto-dist && cp prototype/onebase-prototype.html proto-dist/index.html",
"outputDirectory": "proto-dist",
  "redirects": [
    { "source": "/blogs/:category/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/en-:locale/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/collections/:handle", "destination": "/products", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" } ] },
    { "source": "/(.*)", "has": [ { "type": "host", "value": "test\\.onebasehealth\\.com|.*\\.vercel\\.app" } ], "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ]
}
